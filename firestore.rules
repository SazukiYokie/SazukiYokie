// IELTS Studio KH - Firestore security rules
//
// HOW TO INSTALL (one time, 1 minute):
//   Firebase Console -> Firestore Database -> Rules tab -> paste this whole file -> Publish.
//
// What these rules guarantee:
//   * A signed-in student can read/write ONLY their own data under /users/{their uid}/...
//     (profile, saved tests, essays, results, saved books). Nobody else can read it.
//   * /publicProfiles is the leaderboard. Any signed-in student can read it, but it only holds
//     name, photo, status, streak, average band and points - never email, essays or tests.
//     Students can write only their own card, and points can only go up by a small step per write.
//   * Everything else is locked.
//
// Note: a client-only leaderboard can never be 100% cheat-proof. For a prize-bearing competition,
// move point calculation to a Cloud Function.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---------- Private student data ----------
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /{sub=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---------- Public leaderboard card ----------
    match /publicProfiles/{uid} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['displayName', 'photoURL', 'status', 'studyStreak', 'avgBand', 'points', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.points is number
        && request.resource.data.points >= 0
        && (
             resource == null
             || (request.resource.data.points >= resource.data.points
                 && request.resource.data.points - resource.data.points <= 100)
           );

      allow delete: if false;
    }

    // ---------- Everything else ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
